# Copy to .env and adjust before running `docker compose up`.

# Secret used to sign JWTs in the backend. Use a long random string in production.
JWT_SECRET=change-me-in-production

# Public URLs the backend allows via CORS.
FRONTEND_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002

# Public URL of the backend itself (used for payment callback URLs).
APP_URL=http://localhost:3000

# NexaPay (active payment gateway, card-to-crypto, no KYC/KYB).
# Register the webhook secret under Dashboard -> Settings -> Webhooks; the
# webhook URL itself is set per-payment (callback_url), not globally.
NEXAPAY_API_KEY=
NEXAPAY_WEBHOOK_SECRET=
# One of: USDC, POL, LINK, UNI (all settle on Polygon).
NEXAPAY_CRYPTO_ASSET=USDC

# BTCPay Server (inactive — kept wired for rollback until NexaPay is confirmed live).
# Register the webhook endpoint (event: InvoiceSettled/InvoiceExpired/InvoiceInvalid)
# at: <APP_URL>/api/webhooks/btcpay under Store Settings -> Webhooks, and paste
# the secret it generates below.
BTCPAY_URL=http://localhost:14142
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# B2BinPay crypto gateway (inactive — legacy/alternate provider).
B2BINPAY_API_URL=https://api.b2binpay.com
B2BINPAY_API_KEY=
B2BINPAY_API_SECRET=
B2BINPAY_WALLET_ID=
