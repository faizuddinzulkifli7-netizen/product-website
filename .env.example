# Copy to .env and adjust before running `docker compose up`.

# Secret used to sign JWTs in the backend. Use a long random string in production.
JWT_SECRET=change-me-in-production

# Public URLs the backend allows via CORS.
FRONTEND_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002

# Public URL of the backend itself (used for payment callback URLs).
APP_URL=http://localhost:3000

# Stripe (active payment gateway).
# Register the webhook endpoint at: <APP_URL>/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# B2BinPay crypto gateway (optional — legacy/alternate provider).
B2BINPAY_API_URL=https://api.b2binpay.com
B2BINPAY_API_KEY=
B2BINPAY_API_SECRET=
B2BINPAY_WALLET_ID=
